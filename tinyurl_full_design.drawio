  <diagram name="Rough Estimation" id="page-estimation">
    <mxGraphModel dx="1157" dy="489" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="esttitle" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;" value="Rough Estimation" vertex="1">
          <mxGeometry height="30" width="400" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="assumption" parent="1" style="text;html=1;fontSize=13;fontStyle=2;align=left;fontColor=#666666;" value="Assumptions: 100M new URLs/month, read:write ratio 100:1" vertex="1">
          <mxGeometry height="20" width="600" x="40" y="55" as="geometry" />
        </mxCell>
        <mxCell id="card1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#6C8EBF;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="Writes&#xa;~40 / sec&#xa;100M per month ÷ seconds in a month" vertex="1">
          <mxGeometry height="100" width="220" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="card2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#B85450;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="Reads (redirects)&#xa;~4,000 / sec&#xa;peak up to ~10K/sec at 2-3x" vertex="1">
          <mxGeometry height="100" width="220" x="280" y="100" as="geometry" />
        </mxCell>
        <mxCell id="card3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#82B366;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="Storage per record&#xa;~500 bytes&#xa;short_code + long_url + metadata" vertex="1">
          <mxGeometry height="100" width="220" x="520" y="100" as="geometry" />
        </mxCell>
        <mxCell id="card4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#9673A6;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="Total storage (5 yrs)&#xa;~3TB raw, ~9TB replicated&#xa;100M x 60 months x 500B, 3x replication" vertex="1">
          <mxGeometry height="100" width="220" x="760" y="100" as="geometry" />
        </mxCell>
        <mxCell id="card5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#D79B00;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="Cache sizing&#xa;Tens of GB&#xa;20% of URLs drive ~80% of traffic (Pareto); easily fits in-memory" vertex="1">
          <mxGeometry height="100" width="220" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="card6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#D6B656;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="Key space&#xa;62^7 ≈ 3.5 trillion&#xa;7-char Base62 code, nowhere close to exhausted" vertex="1">
          <mxGeometry height="100" width="220" x="280" y="230" as="geometry" />
        </mxCell>
        <mxCell id="card7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="Bandwidth (redirects)&#xa;~2 MB/sec&#xa;4,000 reads/sec x ~500B response overhead" vertex="1">
          <mxGeometry height="100" width="220" x="520" y="230" as="geometry" />
        </mxCell>
        <mxCell id="card8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#6C8EBF;align=center;verticalAlign=middle;fontSize=13;spacing=8;" value="App servers needed&#xa;~5-10 instances&#xa;assuming ~1K req/sec per instance with headroom" vertex="1">
          <mxGeometry height="100" width="220" x="760" y="230" as="geometry" />
        </mxCell>
        <mxCell id="notebox2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="Notes&#xa;- Read-heavy workload means caching is the single highest-leverage optimization&#xa;- ID generation via range allocation avoids a centralized counter becoming a bottleneck&#xa;- Numbers are back-of-envelope; validate with real traffic patterns before capacity planning" vertex="1">
          <mxGeometry height="120" width="500" x="40" y="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
